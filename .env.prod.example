# Copy to `.env` on the server and fill in. Used by docker-compose.prod.yml.

# --- Required ---
# Session-signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Postgres password for the bundled db service.
DB_PASSWORD=change-me-strong

# --- Image / networking ---
# Pin a specific published tag for reproducible deploys, e.g.
#   ghcr.io/masein/accounting-assistant-api:1.2.3
# Keep :latest for zero-touch auto-updates via Watchtower.
API_IMAGE=ghcr.io/masein/accounting-assistant-api:latest
API_PORT=8000
APP_ENV=prod
# How often (seconds) Watchtower checks the registry for a new image.
WATCHTOWER_POLL_INTERVAL=120
# Comma-separated origins allowed by CORS (set to your public URL).
APP_CORS_ORIGINS=http://localhost:8000

# --- AI provider (Metis is the default; needs a key) ---
AI_PROVIDER=metis
METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/openai/v1
METIS_MODEL=gpt-4o-mini

# --- Optional: Anthropic (Claude) via Metis passthrough ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.metisai.ir/anthropic
# ANTHROPIC_MODEL=claude-opus-4-6

# --- Optional: outgoing mail (see docs/MAIL_SETUP.md) ---
# Mail stays OFF while SMTP_HOST is empty — the app skips sending, it does not
# error. Filling these in is also what switches signup email confirmation on.
# SMTP_USER is the FULL mailbox address on DirectAdmin.
# SMTP_HOST=mail.netixsystem.com
# SMTP_PORT=587
# SMTP_USER=noreply@netixsystem.com
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# For port 465 instead: SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_STARTTLS=false
# SMTP_FROM=noreply@netixsystem.com
# SMTP_FROM_NAME=Accounting Assistant
# Fixed recipient for the operator alert channel.
# SMTP_TO=

# Public base URL used to build links inside emails. A localhost URL is
# useless in an inbox, so set this to what users actually browse to.
APP_PUBLIC_URL=http://localhost:8000

# --- Optional: public self-signup (personal accounts only) ---
# With mail configured, new signups must confirm their address before signing in.
# ALLOW_SELF_SIGNUP=false

# --- Optional: local LM Studio instead of Metis ---
# AI_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234
