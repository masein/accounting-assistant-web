# Copy to `.env` on the server and fill in. Used by docker-compose.prod.yml.

# --- Required ---
# Session-signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Postgres password for the bundled db service.
DB_PASSWORD=change-me-strong

# So plain `docker compose …` in this folder means the production stack.
COMPOSE_FILE=docker-compose.prod.yml

# --- Deploys (the `deployer` service, DEPLOY.md §5) ---
# Registries tried in order for each new image: the first that answers deploys.
# Leave it empty (DEPLOY_REGISTRIES=) on a server without internet.
DEPLOY_REGISTRIES=ghcr.io/masein/accounting-assistant-api docker.netixsystem.com/accounting-assistant-api
# :latest follows main; pin a release (e.g. 1.2.3) for a controlled deploy.
DEPLOY_TAG=latest
# This folder's absolute path (the deployer mounts it at the same path).
DEPLOY_DIR=/opt/accounting
# Seconds between checks; how long a new image gets to turn healthy before the
# previous one is put back; how long a registry that failed is skipped.
DEPLOY_INTERVAL=120
DEPLOY_HEALTH_TIMEOUT=300
DEPLOY_RETRY_AFTER=1800

# --- Networking ---
API_PORT=8000
# Bind the API port to 127.0.0.1 when a reverse proxy (nginx/caddy) on this host
# terminates TLS, so port 8000 is not reachable from the internet.
API_BIND=0.0.0.0
# Proxy address(es) allowed to set X-Forwarded-* (comma-separated; "*" = any).
FORWARDED_ALLOW_IPS=127.0.0.1
# Session cookie Secure flag — keep true (the site is HTTPS).
AUTH_COOKIE_SECURE=true
APP_ENV=prod

# --- Background jobs (in the api container) ---
# Recurring postings, the notification feed and the daily digest run on their
# own now — no browser or external cron needed.
SCHEDULER_ENABLED=true
SCHEDULER_DIGEST_HOUR=8
# --- Backups (the `backup` service) ---
# Host folder that receives the nightly db-*.dump + uploads-*.tgz; sync it off-box.
BACKUP_DIR=./backups
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
# Comma-separated origins allowed by CORS (set to your public URL).
APP_CORS_ORIGINS=http://localhost:8000

# --- AI provider (Metis is the default; needs a key) ---
AI_PROVIDER=metis
METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/openai/v1
METIS_MODEL=gpt-4.1-mini
# Vision model for receipts / statements (Gemini via Metis), a second Gemini
# to try if the first fails, and the OpenAI-compatible last resort.
OCR_MODEL=gemini-3.7-flash
OCR_GEMINI_FALLBACK_MODEL=gemini-2.5-pro
OCR_FALLBACK_MODEL=gpt-4o

# --- Optional: Anthropic (Claude) via Metis passthrough ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.metisai.ir/anthropic
# ANTHROPIC_MODEL=claude-opus-4-6

# --- Optional: outgoing mail (see docs/MAIL_SETUP.md) ---
# Mail stays OFF while SMTP_HOST is empty — the app skips sending, it does not
# error. Filling these in is also what switches signup email confirmation on.
# SMTP_USER is the FULL mailbox address on DirectAdmin.
# SMTP_HOST=mail.netixsystem.com
# SMTP_PORT=587
# SMTP_USER=noreply@netixsystem.com
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# For port 465 instead: SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_STARTTLS=false
# SMTP_FROM=noreply@netixsystem.com
# SMTP_FROM_NAME=Accounting Assistant
# Fixed recipient for the operator alert channel.
# SMTP_TO=

# Public base URL used to build links inside emails. A localhost URL is
# useless in an inbox, so set this to what users actually browse to.
APP_PUBLIC_URL=http://localhost:8000

# --- Optional: public self-signup (personal accounts only) ---
# With mail configured, new signups must confirm their address before signing in.
# ALLOW_SELF_SIGNUP=false

# --- Optional: local LM Studio instead of Metis ---
# AI_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234
