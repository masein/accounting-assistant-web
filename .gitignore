# local env / secrets
.env
.env.*
# the examples are meant to be committed (.env.example, .env.prod.example)
!.env*.example

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/

# node
node_modules/

# os/editor
.DS_Store
.vscode/
.idea/

# cloudflare / wrangler (no longer used)
wrangler.toml
.wranglerignore
container-worker.mjs
package.json

# runtime uploads/logs
app/uploads/
app/private_uploads/
*.log
samples/

# local data dumps / archives (never commit)
*.dump
*.tgz

# claude worktrees
.claude/worktrees/
# nightly backups written by the prod backup service
backups/
e2e-artifacts/
# the deployer's state on a server (scripts/deploy.sh)
.deploy/

# local tool state: never committed (review 2026-11-16)
.claude/settings.local.json
.coverage

# secrets and state of the ops tools when run from inside the repository (review 2026-11-28):
# the relay's bot token, the watchdog's settings and its state, the live copy's settings
ops/telegram-relay/token.env
ops/watchdog/watchdog.env
ops/watchdog/state/
ops/live-copy/.env
