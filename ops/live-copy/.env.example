# Copy to .env (chmod 600). Never commit it: it holds the replication password.
REPL_PASSWORD=                  # the `replicator` role's password on production (DEPLOY.md §13)
SSH_HOST=                       # production's address
# SSH_USER: the server account whose authorized_keys line for this key runs only accounting-copy-gate
# (it needs docker and read access to the volumes)
SSH_USER=
DB_CONTAINER=accounting-db-1    # production's database container
SLOT=mac_replica                # this copy's replication slot on production (one per copy)
SYNC_EVERY=300                  # seconds between file syncs
HOURLY_KEEP_DAYS=7
DAILY_KEEP_DAYS=90
