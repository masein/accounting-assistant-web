# Copy to .env (chmod 600). Never commit it: it holds the bot token and the relay key.
TELEGRAM_BOT_TOKEN=             # from @BotFather
APP_URL=https://accounting.example.com   # the app's public address
RELAY_KEY=                      # Settings → Messenger bots → Telegram → Use a relay (shown once)
