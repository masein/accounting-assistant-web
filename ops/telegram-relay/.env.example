# Copy to .env (chmod 600). Never commit it: it holds the relay key. The bot token is in token.env.
APP_URL=https://app.example.com   # the app's public address
RELAY_KEY=                        # Settings → Messenger bots → Telegram → Use a relay (shown once)
# PLATFORM=telegram
# TELEGRAM_API=https://api.telegram.org
# POLL_TIMEOUT=50
# HELLO_EVERY=600
