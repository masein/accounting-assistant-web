# The watchdog's settings (ops/watchdog/README.md). Copied to watchdog.env by install.sh; nothing secret in it:
# the bot's token is read from the relay's own token.env.

# Who is told: the Telegram chat this user linked in the app (account menu → Telegram), read from the live copy.
# Or a chat id outright.
ALERT_USERNAME=
ALERT_CHAT_ID=
# en or fa
ALERT_LANG=en

APP_URL=https://accounting.netixsystem.com
# the folders of the relay (ops/telegram-relay) and the live copy (ops/live-copy) on this Mac
RELAY_DIR=/path/to/telegram-relay
COPY_DIR=/path/to/prod-replica
RELAY_CONTAINER=telegram-relay-relay-1
REPLICA_CONTAINER=accounting-replica-replica-1

# Thresholds, in seconds (the defaults)
# RELAY_STALE_SECONDS=300
# WAL_STALE_SECONDS=600
# FILES_STALE_SECONDS=1800
# DUMP_STALE_SECONDS=7800
# DISK_MIN_GB=20
# FAILS_BEFORE_ALERT=2
# REMIND_SECONDS=21600
# GAP_SECONDS=1800
